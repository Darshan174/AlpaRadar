# === AlphaRadar Configuration ===

# Crustdata API (https://crustdata.com)
CRUSTDATA_API_KEY=your_crustdata_api_key
CRUSTDATA_BASE_URL=https://api.crustdata.com

# LLM — Groq free tier (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Supabase (https://supabase.com — free tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Alerts (optional)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API Security
API_SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Embedding model (local via fastembed — no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Log level
LOG_LEVEL=INFO
